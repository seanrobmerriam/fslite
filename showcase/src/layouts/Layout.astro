---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "fslite filesystem showcase",
  description = "A browser showcase for the fslite filesystem server.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
