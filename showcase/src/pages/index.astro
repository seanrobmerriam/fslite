---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <section class="hero" aria-labelledby="showcase-title">
      <p class="eyebrow">fslite</p>
      <h1 id="showcase-title">Filesystem server showcase</h1>
      <p>
        Explore the fslite API through a focused, browser-based filesystem
        workspace.
      </p>
    </section>

    <section aria-label="Filesystem showcase">
      <p>The interactive filesystem explorer will appear here.</p>
    </section>
  </main>
</Layout>
