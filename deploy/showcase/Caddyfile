(showcase) {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    reverse_proxy astro:4321
}

{$SHOWCASE_HOSTNAME:localhost} {
    import showcase
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# A loopback-only HTTP route keeps local health checks independent of
# certificate trust. Public hostnames above use Caddy automatic HTTPS.
http://127.0.0.1 {
    import showcase
}
